    "nodemailer": "^8.0.9"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "jest": "29.7.0",
    "babel-jest": "29.7.0",
    "@babel/core": "7.24.7",
    "@babel/preset-env": "7.24.7",
    "supertest": "7.1.1"
  }
