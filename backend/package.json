{
  "name": "fjms-backend",
  "version": "1.0.0",
  "description": "Backend API Server for Freelancer Job Matching System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
